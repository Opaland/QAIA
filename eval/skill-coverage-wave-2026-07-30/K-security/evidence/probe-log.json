    "body": "<!doctype html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"utf-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\r\n  <title>ExpenseFlow — Expense report approval</title>\r\n  <style>\r\n    body { font-family: system-ui, sans-serif; margin: 0; color: #1c2b1e; }\r\n    header { background: #1c2b1e; color: #fff; padding: 1rem; }\r\n    main { max-width: 780px; margin: 1rem auto; padding: 0 1rem; }\r\n    .card { border: 1px solid #ccc; border-radius: 8px; padding: .75rem; margin: .5rem 0; }\r\n    button { background: #1c2b1e; color: #fff; border: 0; border-radius: 6px; padding: .5rem .9rem; cursor: pointer; margin-right: .3rem; }\r\n    button:disabled { background: #9aa; cursor: not-allowed; }\r\n    label { display: block; margin: .5rem 0 .2rem; }\r\n    input, select, textarea { padding: .5rem; width: 100%; box-sizing: border-box; }\r\n    .msg { padding: .6rem; border-radius: 6px; margin: .6rem 0; }\r\n    .msg.error { background: #fde8e8; color: #9b1c1c; }\r\n    .msg.ok { background: #e6f4ea; color: #1e6b34; }\r\n    .line-row { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr auto; gap: .3rem; align-items: center; margin: .3rem 0; }\r\n    .status { font-weight: 600; text-transform: uppercase; font-size: .8rem; padding: .1rem .4rem; border-radius: 4px; background: #eee; }\r\n    .status-approved { background: #e6f4ea; color: #1e6b34; }\r\n    .status-rejected { background: #fde8e8; color: #9b1c1c; }\r\n    .status-submitted { background: #eef3fd; color: #1c3d9b; }\r\n    .status-draft { background: #f2f2f2; color: #555; }\r\n    .status-changes-requested { background: #fff4de; color: #8a5a00; }\r\n    .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }\r\n  </style>\r\n</head>\r\n<body>\r\n  <header><h1>ExpenseFlow</h1></header>\r\n  <main>\r\n    <section id=\"login-section\" aria-labelledby=\"login-h\">\r\n      <h2 id=\"login-h\">Sign in</h2>\r\n      <label for=\"email\">Email</label>\r\n      <input id=\"email\" data-testid=\"email\" type=\"email\" autocomplete=\"username\" />\r\n      <label for=\"password\">Password</label>\r\n      <input id=\"password\" data-testid=\"password\" type=\"password\" autocomplete=\"current-password\" />\r\n      <p><button data-testid=\"login-btn\" id=\"login-btn\">Sign in</button></p>\r\n    </section>\r\n\r\n    <section id=\"app-section\" hidden>\r\n      <p>Signed in as <strong data-testid=\"whoami\" id=\"whoami\"></strong> (<span data-testid=\"role\" id=\"role\"></span>) · <button data-testid=\"logout-btn\" id=\"logout-btn\">Sign out</button></p>\r\n      <div id=\"message\" role=\"status\" aria-live=\"assertive\"></div>\r\n\r\n      <section aria-labelledby=\"new-h\">\r\n        <h2 id=\"new-h\">New expense report</h2>\r\n        <button data-testid=\"new-report-btn\" id=\"new-report-btn\">Start a draft</button>\r\n      </section>\r\n\r\n      <section aria-labelledby=\"draft-h\" id=\"draft-section\" hidden>\r\n        <h2 id=\"draft-h\">Draft <span id=\"draft-id\"></span></h2>\r\n        <label for=\"currency\">Currency</label>\r\n        <select id=\"currency\" data-testid=\"currency\">\r\n          <option value=\"EUR\">EUR</option>\r\n          <option value=\"USD\">USD</option>\r\n          <option value=\"GBP\">GBP</option>\r\n        </select>\r\n        <div id=\"lines\" data-testid=\"lines\"></div>\r\n        <button data-testid=\"add-line-btn\" id=\"add-line-btn\" type=\"button\">Add line</button>\r\n        <p><button data-testid=\"submit-report-btn\" id=\"submit-report-btn\" type=\"button\">Submit for approval</button></p>\r\n      </section>\r\n\r\n      <section aria-labelledby=\"mine-h\">\r\n        <h2 id=\"mine-h\">My reports</h2>\r\n        <div id=\"mine\" data-testid=\"mine\" role=\"list\"></div>\r\n      </section>\r\n\r\n      <section aria-labelledby=\"inbox-h\">\r\n        <h2 id=\"inbox-h\">Approval inbox (<span id=\"role2\"></span>)</h2>\r\n        <div id=\"inbox\" data-testid=\"inbox\" role=\"list\"></div>\r\n      </section>\r\n    </section>\r\n  </main>\r\n  <script src=\"/app.js\"></script>\r\n</body>\r\n</html>\r\n",
    "rawBody": "<!doctype html>\r\n<html lang=\"en\">\r\n<head>\r\n  <meta charset=\"utf-8\" />\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\r\n  <title>ExpenseFlow — Expense report approval</title>\r\n  <style>\r\n    body { font-family: system-ui, sans-serif; margin: 0; color: #1c2b1e; }\r\n    header { background: #1c2b1e; color: #fff; padding: 1rem; }\r\n    main { max-width: 780px; margin: 1rem auto; padding: 0 1rem; }\r\n    .card { border: 1px solid #ccc; border-radius: 8px; padding: .75rem; margin: .5rem 0; }\r\n    button { background: #1c2b1e; color: #fff; border: 0; border-radius: 6px; padding: .5rem .9rem; cursor: pointer; margin-right: .3rem; }\r\n    button:disabled { background: #9aa; cursor: not-allowed; }\r\n    label { display: block; margin: .5rem 0 .2rem; }\r\n    input, select, textarea { padding: .5rem; width: 100%; box-sizing: border-box; }\r\n    .msg { padding: .6rem; border-radius: 6px; margin: .6rem 0; }\r\n    .msg.error { background: #fde8e8; color: #9b1c1c; }\r\n    .msg.ok { background: #e6f4ea; color: #1e6b34; }\r\n    .line-row { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr auto; gap: .3rem; align-items: center; margin: .3rem 0; }\r\n    .status { font-weight: 600; text-transform: uppercase; font-size: .8rem; padding: .1rem .4rem; border-radius: 4px; background: #eee; }\r\n    .status-approved { background: #e6f4ea; color: #1e6b34; }\r\n    .status-rejected { background: #fde8e8; color: #9b1c1c; }\r\n    .status-submitted { background: #eef3fd; color: #1c3d9b; }\r\n    .status-draft { background: #f2f2f2; color: #555; }\r\n    .status-changes-requested { background: #fff4de; color: #8a5a00; }\r\n    .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }\r\n  </style>\r\n</head>\r\n<body>\r\n  <header><h1>ExpenseFlow</h1></header>\r\n  <main>\r\n    <section id=\"login-section\" aria-labelledby=\"login-h\">\r\n      <h2 id=\"login-h\">Sign in</h2>\r\n      <label for=\"email\">Email</label>\r\n      <input id=\"email\" data-testid=\"email\" type=\"email\" autocomplete=\"username\" />\r\n      <label for=\"password\">Password</label>\r\n      <input id=\"password\" data-testid=\"password\" type=\"password\" autocomplete=\"current-password\" />\r\n      <p><button data-testid=\"login-btn\" id=\"login-btn\">Sign in</button></p>\r\n    </section>\r\n\r\n    <section id=\"app-section\" hidden>\r\n      <p>Signed in as <strong data-testid=\"whoami\" id=\"whoami\"></strong> (<span data-testid=\"role\" id=\"role\"></span>) · <button data-testid=\"logout-btn\" id=\"logout-btn\">Sign out</button></p>\r\n      <div id=\"message\" role=\"status\" aria-live=\"assertive\"></div>\r\n\r\n      <section aria-labelledby=\"new-h\">\r\n        <h2 id=\"new-h\">New expense report</h2>\r\n        <button data-testid=\"new-report-btn\" id=\"new-report-btn\">Start a draft</button>\r\n      </section>\r\n\r\n      <section aria-labelledby=\"draft-h\" id=\"draft-section\" hidden>\r\n        <h2 id=\"draft-h\">Draft <span id=\"draft-id\"></span></h2>\r\n        <label for=\"currency\">Currency</label>\r\n        <select id=\"currency\" data-testid=\"currency\">\r\n          <option value=\"EUR\">EUR</option>\r\n          <option value=\"USD\">USD</option>\r\n          <option value=\"GBP\">GBP</option>\r\n        </select>\r\n        <div id=\"lines\" data-testid=\"lines\"></div>\r\n        <button data-testid=\"add-line-btn\" id=\"add-line-btn\" type=\"button\">Add line</button>\r\n        <p><button data-testid=\"submit-report-btn\" id=\"submit-report-btn\" type=\"button\">Submit for approval</button></p>\r\n      </section>\r\n\r\n      <section aria-labelledby=\"mine-h\">\r\n        <h2 id=\"mine-h\">My reports</h2>\r\n        <div id=\"mine\" data-testid=\"mine\" role=\"list\"></div>\r\n      </section>\r\n\r\n      <section aria-labelledby=\"inbox-h\">\r\n        <h2 id=\"inbox-h\">Approval inbox (<span id=\"role2\"></span>)</h2>\r\n        <div id=\"inbox\" data-testid=\"inbox\" role=\"list\"></div>\r\n      </section>\r\n    </section>\r\n  </main>\r\n  <script src=\"/app.js\"></script>\r\n</body>\r\n</html>\r\n"
